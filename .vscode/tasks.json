{
  // Press Ctrl+Shift+B in VS Code (or Terminal > Run Build Task...) to start MoneyFlow.
  // Then open http://localhost:3000/login in your browser. Press Ctrl+C in the terminal panel to stop it.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MoneyFlow",
      "type": "shell",
      "command": "node server.js",
      "options": { "cwd": "${workspaceFolder}/moneyflow" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false },
      "problemMatcher": []
    }
  ]
}
